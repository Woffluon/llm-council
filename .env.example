# Provider Choice: openrouter | nvidia_nim | gemini
PROVIDER=gemini

# API Keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
NVIDIA_API_KEY=your_nvidia_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Council Models (comma-separated list)
# Example for OpenRouter: openai/gpt-4o,google/gemini-2.5-pro,anthropic/claude-3.5-sonnet,z-ai/glm-5.2
# Example for NVIDIA NIM: nvidia/llama-3.1-nemotron-70b-instruct,meta/llama-3.3-70b-instruct,mistralai/mistral-large-2-instruct,deepseek-ai/deepseek-r1
# Example for Gemini: gemini-2.5-pro,gemini-2.5-flash,gemini-2.0-flash,gemini-1.5-pro
COUNCIL_MODELS=gemini-2.5-pro,gemini-2.5-flash,gemini-2.0-flash,gemini-1.5-pro

# Chairman Model (synthesizes final response)
CHAIRMAN_MODEL=gemini-2.5-pro
